#!/bin/bash
# 사이니지 시작 — 이 파일을 더블클릭하면 됩니다.
#   · 뉴스 수집기를 켜고 (매시 00·10·20·30·40·50분에 수집)
#   · 화면 서버를 켭니다
# 끄려면 이 창에서 Ctrl+C 를 누르거나 창을 닫으세요.

cd "$(dirname "$0")" || exit 1

echo ""
echo "  ──────────────────────────────────────────"
echo "   사이니지 시작"
echo "  ──────────────────────────────────────────"

# 이미 돌고 있던 것들을 먼저 정리합니다 (중복 실행 방지)
#   ※ 파일 이름이 한글이라 pkill 로는 못 잡히는 경우가 있어,
#     남겨 둔 번호(.수집기.pid)로 정확히 종료합니다.
if [ -f ".수집기.pid" ]; then
  kill "$(cat .수집기.pid)" 2>/dev/null && echo "   먼저 돌던 수집기를 정리했습니다"
  rm -f .수집기.pid
fi
pkill -f "서버.py" 2>/dev/null
pkill -f "수집기" 2>/dev/null
pkill -f "http.server 8899" 2>/dev/null
sleep 1

# 뉴스 수집기 — 뒤에서 계속 돕니다
./.venv/bin/python 수집기.py --반복 > 수집기.log 2>&1 &
echo "   뉴스 수집기 켰습니다 (기록: 수집기.log)"

# 화면 서버 — 이 창에서 돕니다
./.venv/bin/python 서버.py
