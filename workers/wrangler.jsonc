{
  // 공공데이터포털은 해외에서 응답하지 않습니다. 이 중계소는 부르는 쪽(사이니지, 한국)과
  // 가까운 곳에서 실행되므로 국내 속도로 받아옵니다.
  //
  // 인증키는 여기 두지 않습니다:
  //   npx wrangler secret put DATA_GO_KR_KEY
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signage-data",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",

  // GitHub 의 예약 실행(schedule)은 짧은 주기를 자주 건너뜁니다.
  // 여기서 정확히 깨워 주고, 뉴스 수집은 그쪽에서 하게 둡니다.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // 지역·정류소는 여기 적지 않습니다. 저장소가 공개라 근무지가 드러나기 때문입니다.
  // 아래 이름들을 Secret 으로 넣습니다 (npx wrangler secret put <이름>):
  //   LOCATION GRID_X GRID_Y LAT LON MID_LAND MID_TA AIR_STATION UV_AREA
  //   BUS_ARS BUS_STID BUS_PIN
  // 값이 없으면 서울시청 좌표로 돕니다(코드 안의 기본값).
  "vars": {
    "GH_REPO": "jhmigfailindo-ops/LH43QBCEBGCXKR_system",
    "GH_WORKFLOW": "335605241",
    "GH_REF": "main"
  }
}
